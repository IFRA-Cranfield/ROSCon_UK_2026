<robot name="irb120" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- PASS ARGUMENTS: -->
  <xacro:arg name="bringup" default="false"/>
  <xacro:property name="bringup" value="$(arg bringup)"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:property name="robot_ip" value="$(arg robot_ip)"/>

  <xacro:arg name="EE" default="true"/>
  <xacro:property name="EE" value="$(arg EE)"/>
  <xacro:arg name="EE_name" default="none"/>
  <xacro:property name="EE_name" value="$(arg EE_name)"/>

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- Include XACRO-MACRO file of the IRB120: -->
  <xacro:include filename="$(find ros2srrc_robots)/irb120/urdf/irb120_macro.urdf.xacro"/>	
  <xacro:irb120 
    bringup="${bringup}"
    robot_ip="${robot_ip}"
    EE="${EE}"
    EE_name="${EE_name}"
    prefix="${prefix}"
  />

  <!-- Include XACRO-MACRO file of the EGP64: -->
  <xacro:include filename="$(find ros2srrc_endeffectors)/egp64/urdf/egp64_macro.urdf.xacro"/>	
  <xacro:egp64 
    bringup="${bringup}"
    parent_link="${prefix}tool0"
    prefix="${prefix}"
  />

  <!-- Load ROS 2 Gazebo Plugin -->
  <xacro:unless value="${bringup}">
    
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">

        <!-- IRB120 Controller -->
        <parameters>$(find ros2srrc_robots)/irb120/config/controller.yaml</parameters>

        <!-- End-Effector Controller (if needed) -->
        <parameters>$(find ros2srrc_endeffectors)/${EE_name}/config/controller.yaml</parameters>

      </plugin>
    </gazebo>

  </xacro:unless>

  <!-- World: LINK -->
  <link name="world"/>
  
  <!-- ABB IRB-120 ENCLOSURE -->
  <link name="${prefix}cell">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rosconuk26)/meshes/irb120enclosure/IRB120enclosure.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rosconuk26)/meshes/irb120enclosure/IRB120enclosure.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="200.0" ixy="0.0" ixz="0.0" iyy="200.0" iyz="0.0" izz="200.0"/>
    </inertial>
  </link>

  <!-- Robot Cell: FIXED JOINT -->
  <joint name="${prefix}world-cell-fixed" type="fixed">
    <parent link="world"/>
    <child link="${prefix}cell"/>
    <origin xyz="0.926 -0.124 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- Robot+Cell JOINT -->
  <joint name="${prefix}cell-base_link-fixed" type="fixed">
    <parent link="${prefix}cell"/>
    <child link="${prefix}base_link"/>
    <origin xyz="-0.6506 0.6489 0.8605" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ERGOBOX -->
  <link name="${prefix}ergobox">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rosconuk26)/meshes/irb120enclosure/ergobox.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find rosconuk26)/meshes/irb120enclosure/ergobox.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="200.0" ixy="0.0" ixz="0.0" iyy="200.0" iyz="0.0" izz="200.0"/>
    </inertial>
  </link>

  <!-- Ergobox: FIXED JOINT -->
  <joint name="${prefix}ergobox-cell-fixed" type="fixed">
    <parent link="${prefix}cell"/>
    <child link="${prefix}ergobox"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ARUCO TAG -->
  <xacro:unless value="${bringup}">

    <!-- ARUCO GRID -->
    <link name="${prefix}aruco_grid">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find rosconuk26)/meshes/aruco/arucoGrid.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002" />
      </inertial>
    </link>
    <joint name="${prefix}cell-aruco_grid-fixed" type="fixed">
      <parent link="${prefix}cell"/>
      <child link="${prefix}aruco_grid"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <gazebo reference="${prefix}cell-aruco_grid-fixed">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

  </xacro:unless>

  <!-- CAMERA -->
  <xacro:unless value="${bringup}">
    
    <link name="${prefix}camera_link">
    
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="1.0" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>

    </link>

    <joint name="${prefix}camera_joint" type="fixed">
      <origin xyz="0.776 0.526 1.90" rpy="0 1.23 3.1416"/>
      <parent link="world"/>
      <child link="${prefix}camera_link"/>
    </joint>

    <gazebo reference="${prefix}camera_link">

      <sensor name="${prefix}camera" type="camera">
      
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>

        <!-- Gz Transport topic -->
        <topic>/camera/image_raw</topic>

        <camera name="head">

          <horizontal_fov>1.22</horizontal_fov>

          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>

          <clip><near>0.02</near><far>300</far></clip>

          <camera_info_topic>/camera/camera_info</camera_info_topic>

        </camera>

      </sensor>
      
    </gazebo>

  </xacro:unless>

</robot>